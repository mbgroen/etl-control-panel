# =============================================================================
# ET: Legacy Control Panel — environment
#
# Copy to .env and fill in every value marked REQUIRED.
#   cp .env.example .env
#
# NEVER commit the completed .env: it holds your rcon password and the key that
# signs control panel sessions.
# =============================================================================

# --- Paths -------------------------------------------------------------------
# Root directory for persistent data on the host. Two subdirectories are created
# under it: etl-server/ (game data) and etl-control-panel/ (backups + history).
#
# Any absolute path on the host works; put it on the disk with room for maps.
# REQUIRED
COMPOSE_DATA_PATH=/srv/appdata

# --- Ports -------------------------------------------------------------------
# The game port is NOT set here. The game server runs on the host network, so
# it binds whatever net_port says in the server config — 27960 unless you
# change it — and no Docker port mapping is involved.
#
# That is deliberate. The heartbeat a server sends to the master carries no
# port number; the master reads the port off the packet's source. Behind a
# bridge with a published port, outbound packets are masqueraded to a random
# high port, so the master advertises your server where nothing is listening
# and every player who clicks Join gets a connection error. On the host network
# the heartbeat leaves from the real port.

# How the control panel reaches the game server for status and rcon. The game
# server is on the host network, so this is the host as seen from a container;
# the compose file teaches that name to Docker. A LAN IP works too.
ETL_HOST=host.docker.internal
ETL_PORT=27960

# Host side only — the control panel listens on 8080 and nginx on 80 inside
# their containers whatever you put here. 8085 because 8080 is contended on a
# NAS. A FastDL port you change must appear in the base URL players are given.
CONTROL_PANEL_PORT=8085
FASTDL_PORT=8081

# --- Control panel credentials ---------------------------------------------------
# BOTH OPTIONAL. Leave them empty and the control panel asks you to create an admin
# account the first time you open it in a browser, storing it under STATE_PATH.
# That is the simplest route and the one the quick install uses.
#
# Fill them in only if you would rather manage credentials as code. They then
# take precedence over any account created through the wizard.
ADMIN_USERNAME=admin

# Bcrypt hash of your control panel password — NOT the password itself. Generate
# this and SESSION_SECRET with:
#   docker compose run --rm --no-deps --entrypoint node control-panel dist/cli/hashPassword.js
ADMIN_PASSWORD_HASH=

# Signs session cookies. Any random 32+ byte hex string; rotating it signs
# everyone out. Generated and persisted automatically when left empty.
SESSION_SECRET=

# How long a sign-in lasts before it must be repeated.
SESSION_TTL_HOURS=12

# Set to true ONLY when the control panel is served over HTTPS. On plain HTTP a
# secure cookie is never sent back by the browser and sign-in silently fails.
COOKIE_SECURE=false

# --- Game server -------------------------------------------------------------
# Must match "set rconpassword" in your server config. Without it the control panel
# still works, but the console and player kick/ban are disabled.
RCON_PASSWORD=

# The filename the game server execs at start-up, inside etmain.
SERVER_CONFIG_NAME=etl_server.cfg

# --- FastDL ------------------------------------------------------------------
# The URL *players* use to download maps. Must be reachable from their machines,
# so use the host's LAN IP or public hostname — not "localhost" and not a Docker
# service name. Include the port and no trailing slash.
#   LAN only:  http://192.168.1.10:8081
#   Internet:  http://your-domain.example:8081
FASTDL_BASE_URL=

# --- Host user & permissions -------------------------------------------------
# The control panel runs as this uid/gid and must be able to WRITE the etmain
# directory (it edits the config and installs .pk3 uploads).
#   Check with: stat -c '%u %g' /path/to/appdata/etl-server/etmain
# Only used by the compose file in the repository root, which runs the
# control panel unprivileged. The published-images file in deploy/ runs it
# as root instead — see the note in that file — and ignores these three.
PUID=1000
PGID=100

# GID of the host's docker group, needed to use the Docker socket unprivileged.
#   Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Tuning ------------------------------------------------------------------
# Seconds between status polls. Lower is more responsive but queries the game
# server more often.
POLL_INTERVAL_SEC=10

# Largest .pk3 accepted by the uploader, in megabytes.
# Only the starting value. The limit is editable under Configuration →
# Control panel, and once changed there the stored setting takes precedence.
MAX_UPLOAD_MB=256

# Resolve player addresses to a country for the Players page. This is the only
# outbound request the control panel makes: public addresses go to ipwho.is, private
# ones never leave the host, and player names are never sent. Set false to keep
# everything local — the page still works, just without countries.
GEO_LOOKUP=true

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
