// =============================================================================
// ET: Legacy — server configuration
//
// Copy this to <COMPOSE_DATA_PATH>/etlegacy/etmain/etl_server.cfg and edit it,
// or manage it from the control panel's Configuration page (which keeps timestamped
// backups of every change).
//
// Colour codes for names and messages:
//   ^0 black   ^1 red     ^2 green   ^3 yellow  ^4 blue
//   ^5 cyan    ^6 magenta ^7 white   ^8 orange  ^9 grey
// =============================================================================


// --- Identity ----------------------------------------------------------------
set sv_hostname     "^7[^2TTW^7] ^1Time to ^3Waste^7!"
set g_motd          "Kill 'm all, before they kill you..."

// 2 = dedicated internet server. Anything else and the master servers will not
// list you, so the server never appears in the public browser.
set dedicated       "2"


// --- Players & access --------------------------------------------------------
set sv_maxclients   "20"    // total slots, including the private ones below
set g_maxGameClients "20"   // how many of those may join a team (rest spectate)

set g_password      ""      // empty = public server

// Reserved slots. These are subtracted from the public pool: with 20 max and 2
// private, 18 people can join without the password.
set sv_privateClients  "2"
set sv_privatePassword ""   // set this to use the reserved slots

// Required by the control panel console and by player kick/ban. Left empty on
// purpose: a placeholder that ships in a public repository is a known password
// on every server whose operator did not get round to changing it. Set it on
// the control panel's Configuration page — it is picked up immediately, and the
// running server is moved onto it without a restart.
set rconpassword    ""

set sv_floodProtect "1"     // rate-limit chat/command spam from one client


// --- Network -----------------------------------------------------------------
set net_ip          ""      // empty = bind all interfaces (required in Docker)
set net_port        "27960"

// The engine's stock rate limits date from the dial-up era and throttle modern
// connections badly.
set sv_maxRate      "25000"


// --- Gameplay ----------------------------------------------------------------
// 2 = Objective (single map at a time, driven by the rotation below)
// 4 = Campaign  (chains maps from g_campaignFile — see the note at the bottom)
set g_gametype      "2"

set timelimit       "25"
set fraglimit       "0"     // 0 = objectives decide the round, not kills
set g_friendlyFire  "1"
set g_gravity       "800"   // engine default
set g_speed         "320"   // engine default
set g_blood         "1"


// --- Downloads ---------------------------------------------------------------
// Leave sv_allowDownload on: with it off, anyone missing a custom map simply
// cannot join.
set sv_allowDownload "1"

// HTTP (FastDL) settings. Manage these from the control panel's Maps & FastDL page
// rather than by hand — it sets both values together and verifies the URL is
// actually reachable, which is the step people usually miss.
set sv_wwwDownload   "0"
set sv_wwwBaseURL    ""

// Only used when FastDL is off; this is the slow in-game UDP transfer.
set sv_dl_maxRate    "42000"


// --- Map rotation ------------------------------------------------------------
// ET chains maps through the "nextmap" cvar: each entry loads a map and points
// nextmap at the following entry, and the final entry loops back to the first.
// The trailing `vstr` is what actually starts the rotation — without it nothing
// happens and the server sits on whatever map it booted with.
//
// The control panel rewrites this block when you edit the rotation in the UI.
//
// >>> control-panel:rotation — managed block, edit via the control panel
set mr1 "map oasis ; set nextmap vstr mr2"
set mr2 "map radar ; set nextmap vstr mr3"
set mr3 "map railgun ; set nextmap vstr mr4"
set mr4 "map fueldump ; set nextmap vstr mr5"
set mr5 "map battery ; set nextmap vstr mr6"
set mr6 "map goldrush ; set nextmap vstr mr1"
vstr mr1
// <<< control-panel:rotation


// --- Campaign mode (only for g_gametype 4) -----------------------------------
// These are inert while g_gametype is 2. Setting them alongside gametype 2 does
// nothing — a common source of "my campaign rotation is being ignored".
// To run the stock 6-map campaign instead of the rotation above:
//   1. set g_gametype "4"
//   2. uncomment the two lines below
//   3. delete or comment out the rotation block above
//
// set g_campaigns     "1"
// set g_campaignFile  "scripts/base.campaign"
